# Semua ini di-set di Vercel Project Settings -> Environment Variables (production),
# BUKAN di file .env yang ikut ke-commit. File ini cuma dokumentasi nama variabelnya.

# Wajib untuk fitur Login Google (OAuth2 asli):
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_SECRET=

# Opsional — menaikkan rate limit GitHub API saat validasi repo publik tanpa PAT:
GITHUB_TOKEN=

# Wajib di production untuk menyimpan data dashboard (history, domains, env vars,
# settings tokens) per akun Google, bukan di localStorage browser:
# di Vercel dashboard -> Storage -> Create Database -> KV, lalu "Connect" ke project ini.
# Vercel otomatis mengisi 2 variabel ini setelah di-connect (nggak perlu diisi manual).
KV_REST_API_URL=
KV_REST_API_TOKEN=
