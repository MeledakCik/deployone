# Semua ini di-set di Vercel Project Settings -> Environment Variables (production),
# BUKAN di file .env yang ikut ke-commit. File ini cuma dokumentasi nama variabelnya.

# Wajib untuk fitur Login Google (OAuth2 asli):
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_SECRET=

# Opsional — menaikkan rate limit GitHub API saat validasi repo publik tanpa PAT:
GITHUB_TOKEN=

# Wajib di production untuk menyimpan data dashboard (history, domains, env vars,
# settings tokens) per akun Google, bukan di localStorage browser:
# di Vercel dashboard -> Storage -> Create Database -> KV, lalu "Connect" ke project ini.
# Vercel otomatis mengisi 2 variabel ini setelah di-connect (nggak perlu diisi manual).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Chat CS berbasis AI (Groq Cloud). Tanpa GROQ_API_KEY, widget chat tetap muncul
# tapi menjawab "belum aktif". Buat key di https://console.groq.com/keys
GROQ_API_KEY=
# Opsional. Default: openai/gpt-oss-120b.
# llama-3.3-70b-versatile sudah dimatikan Groq pada 16 Agustus 2026.
GROQ_MODEL=
# Opsional — laporan dari chat bantuan (tombol "Laporkan ke developer" + laporan otomatis).
# Notifikasi Telegram: buat bot lewat @BotFather (lihat README, bagian "Notifikasi Telegram").
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Opsional: webhook https (Discord/Slack) sebagai tambahan atau pengganti Telegram.
SUPPORT_WEBHOOK_URL=
# Email Google developer (pisahkan dengan koma) yang boleh membaca laporan lewat
# GET /api/support/report dan mengetes Telegram lewat GET /api/support/report?test=telegram
ADMIN_EMAILS=

# Donasi lewat Saweria (menu "Donasi" di dashboard). Saweria tidak punya API resmi;
# aplikasi memakai endpoint halaman donasi publik mereka (lihat app/api/_lib/saweria.ts).
# Tanpa SAWERIA_USERNAME, menu Donasi tampil tapi menyatakan "belum diaktifkan".
SAWERIA_USERNAME=
# Opsional tapi disarankan: ID akun Saweria kamu (UUID). Kalau kosong, ID dibaca otomatis
# dari halaman saweria.co/<username>. Cari di view-source halaman itu: "__NEXT_DATA__" -> data.id
SAWERIA_USER_ID=
