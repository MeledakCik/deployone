# Semua ini di-set di Vercel Project Settings -> Environment Variables (production),
# BUKAN di file .env yang ikut ke-commit. File ini cuma dokumentasi nama variabelnya.

# Wajib untuk fitur Login Google (OAuth2 asli):
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_SECRET=

# Opsional — menaikkan rate limit GitHub API saat validasi repo publik tanpa PAT:
GITHUB_TOKEN=

# Wajib di production untuk menyimpan data dashboard (history, domains, env vars,
# settings tokens) per akun Google, bukan di localStorage browser:
# di Vercel dashboard -> Storage -> Create Database -> KV, lalu "Connect" ke project ini.
# Vercel otomatis mengisi 2 variabel ini setelah di-connect (nggak perlu diisi manual).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Wajib di production — database Supabase (Postgres) untuk data yang harus awet:
# data dashboard user, direktori user, laporan abuse/bantuan, kampanye email, audit, pengaturan.
# 1) Buat project di https://supabase.com  2) SQL Editor -> jalankan isi supabase/schema.sql
# 3) Project Settings -> API: salin "Project URL" dan key "service_role".
# service_role = kunci penuh, HANYA di server. Jangan pakai prefix NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Opsional — batas paket untuk meter pemakaian di panel admin (MB). Default: Supabase 500, Redis 256.
SUPABASE_LIMIT_MB=
REDIS_LIMIT_MB=

# Chat CS berbasis AI (Groq Cloud). Tanpa GROQ_API_KEY, widget chat tetap muncul
# tapi menjawab "belum aktif". Buat key di https://console.groq.com/keys
GROQ_API_KEY=
# Opsional. Default: openai/gpt-oss-120b.
# llama-3.3-70b-versatile sudah dimatikan Groq pada 16 Agustus 2026.
GROQ_MODEL=
# Opsional — laporan dari chat bantuan (tombol "Laporkan ke developer" + laporan otomatis).
# Notifikasi Telegram: buat bot lewat @BotFather (lihat README, bagian "Notifikasi Telegram").
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Opsional: webhook https (Discord/Slack) sebagai tambahan atau pengganti Telegram.
SUPPORT_WEBHOOK_URL=
# Panel admin (/admin) HANYA untuk depupdev@gmail.com (sudah tertanam di kode, tidak perlu env).
# OPSIONAL: tambahkan email Google admin lain, pisahkan dengan koma.
ADMIN_EMAILS=

# Donasi lewat Saweria (menu "Donasi" di dashboard). Saweria tidak punya API resmi;
# aplikasi memakai endpoint halaman donasi publik mereka (lihat app/api/_lib/saweria.ts).
# Tanpa SAWERIA_USERNAME, menu Donasi tampil tapi menyatakan "belum diaktifkan".
SAWERIA_USERNAME=
# Opsional tapi disarankan: ID akun Saweria kamu (UUID). Kalau kosong, ID dibaca otomatis
# dari halaman saweria.co/<username>. Cari di view-source halaman itu: "__NEXT_DATA__" -> data.id
SAWERIA_USER_ID=

# Link Gaib / tunnel (`npx depup-cli share`) DAN Link Instan (upload zip/folder di dashboard,
# wajib TUNNEL_BASE_DOMAIN). Semua opsional.
# Domain dasar untuk link berbentuk https://<nama>.<domain>. Butuh wildcard domain
# (*.domain) di Vercel — lihat README.md, bagian "Link Gaib". Kosong = mode path:
# https://<host-depup>/t/<nama>/ (aplikasi yang memakai path absolut seperti /assets/x.js
# bisa rusak di mode ini, jadi subdomain sangat disarankan).
# Saran: pakai domain TERPISAH dari situs utama Depup (mis. depup.link), bukan subdomain-nya.
TUNNEL_BASE_DOMAIN=
# Masa aktif link dalam menit (default 120, maks 480).
TUNNEL_TTL_MINUTES=
# Isi "false" untuk mematikan fitur ini sepenuhnya.
TUNNEL_ENABLED=

# Batas hosting statis Link Instan. Semua isi situs disimpan di Redis, jadi ini = pagar memori Redis kamu.
# SITES_MAX_MB = ukuran maks satu situs (default 10, maks 50). SITES_MAX_PER_USER = jumlah link maks per akun
# termasuk upload yang belum selesai (default 3, maks 10).
SITES_MAX_MB=10
SITES_MAX_PER_USER=3

# Batas data per link Gaib (MB). Tiap byte response dititipkan lewat Redis (ditulis lalu dibaca), jadi ini
# pagar pemakaian Redis. Habis = pengunjung berikutnya melihat "Kuota link habis". 0 = tanpa batas. Default 150.
TUNNEL_MAX_MB=150
# Konektor MCP untuk Claude (publish website dari chat). Tidak perlu env baru: memakai AUTH_SECRET + Redis yang ada.
# NEXT_PUBLIC_SITE_URL = origin publik Depup untuk metadata OAuth (default https://depup.cloud).
# MCP_REDIRECT_HOSTS = host tambahan (pisah koma) yang boleh jadi redirect_uri selain claude.ai / claude.com.
MCP_REDIRECT_HOSTS=

# Takedown abuse: lewat panel /admin -> Abuse & Takedown (atau POST /api/admin/takedown).

# Email lewat Resend (menu Promosi + balasan Bantuan + notifikasi laporan baru ke admin).
# Buat key di https://resend.com/api-keys (izin "Sending access"). Domain depup.web.id sudah verified.
# JANGAN commit key ini / jangan dibagikan di chat — kalau pernah terbuka, hapus & buat ulang.
RESEND_API_KEY=
# Opsional. Default: Depup <info@depup.web.id>  (HARUS memakai domain yang verified di Resend)
EMAIL_FROM=
# Opsional. Balasan user ke email dari Depup masuk ke alamat ini. Default: depupdev@gmail.com
EMAIL_REPLY_TO=

# Link media sosial di footer landing (opsional; kalau kosong dipakai nilai bawaan @depup)
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_TIKTOK_URL=
NEXT_PUBLIC_TWITTER_URL=

# --- AI Site (menu AI di dashboard) ---
# Setiap akun memasang token Groq-nya sendiri di menu AI Site (terenkripsi, dipakai server saja).
# Jatah coba gratis per akun per hari memakai GROQ_API_KEY server. 0 = wajib pakai token sendiri (disarankan).
AI_FREE_PER_DAY=0

# ───────── Database (Turso) ─────────
# Platform API token: turso auth api-tokens mint depup
TURSO_API_TOKEN=
# Slug org / akun personal: turso org list
TURSO_ORG=
# Nama group (harus sudah ada): turso group create default
TURSO_GROUP=default
# (opsional) Batas total penyimpanan paket Turso dalam MB, dipakai meter di admin > Database. Bawaan 5120.
TURSO_LIMIT_MB=
